{
  "GOOGLE_CLIENT_ID": "@Microsoft.KeyVault(SecretUri=https://healthsync-vault-example.vault.azure.net/secrets/google-client-id)",
  "GOOGLE_CLIENT_SECRET": "@Microsoft.KeyVault(SecretUri=https://healthsync-vault-example.vault.azure.net/secrets/google-client-secret)",
  "GOOGLE_REFRESH_TOKEN": "@Microsoft.KeyVault(SecretUri=https://healthsync-vault-example.vault.azure.net/secrets/google-refresh-token)",
